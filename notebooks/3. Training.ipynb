    "import os\n",
    "import yaml\n",
    "from audiomancy.constants import CONFIGS\n",
    "from audiomancy import train\n",
    "import warnings\n",
    "warnings.filterwarnings('ignore')\n",
    "\n",
    "with open(os.path.join(CONFIGS,'default.yaml'),'r') as f:\n",
    "    args = yaml.safe_load(f)\n",
    "    \n",
    "train.start(args)"
   ]
  }
